  "verse_distinctive_phrases": {
    "1": "ن والقلم وما يسطرون",
    "2": "انت بنعمه ربك بمجنون",
    "3": "لك لاجرا غير ممنون",
    "4": "وانك لعلي خلق عظيم",
    "5": "فستبصر ويبصرون",
    "6": "باييكم المفتون",
    "7": "سبيله وهو اعلم بالمهتدين",
    "8": "فلا تطع المكذبين",
    "9": "ودوا لو تدهن فيدهنون",
    "10": "تطع كل حلاف مهين",
    "11": "هماز مشاء بنميم",
    "12": "مناع للخير معتد اثيم",
    "13": "عتل بعد ذلك زنيم",
    "14": "كان ذا مال وبنين",
    "15": "اذا تتلي عليه اياتنا",
    "16": "سنسمه علي الخرطوم",
    "17": "بلوناهم كما بلونا اصحاب",
    "18": "ولا يستثنون",
    "19": "فطاف عليها طائف من",
    "20": "فاصبحت كالصريم",
    "21": "فتنادوا مصبحين",
    "22": "حرثكم ان كنتم صارمين",
    "23": "فانطلقوا وهم يتخافتون",
    "24": "يدخلنها اليوم عليكم مسكين",
    "25": "وغدوا علي حرد قادرين",
    "26": "راوها قالوا انا لضالون",
    "27": "بل نحن محرومون",
    "28": "اقل لكم لولا تسبحون",
    "29": "ربنا انا كنا ظالمين",
    "30": "بعضهم علي بعض يتلاومون",
    "31": "ويلنا انا كنا طاغين",
    "32": "يبدلنا خيرا منها انا",
    "33": "كذلك العذاب ولعذاب الاخره",
    "34": "للمتقين عند ربهم جنات",
    "35": "افنجعل المسلمين كالمجرمين",
    "36": "ما لكم كيف تحكمون",
    "37": "لكم كتاب فيه تدرسون",
    "38": "لكم فيه لما تخيرون",
    "39": "لكم ايمان علينا بالغه",
    "40": "سلهم ايهم بذلك زعيم",
    "41": "لهم شركاء فلياتوا بشركائهم",
    "42": "الي السجود فلا يستطيعون",
    "43": "خاشعه ابصارهم ترهقهم ذله",
    "44": "يكذب بهذا الحديث سنستدرجهم",
    "45": "واملي لهم ان كيدي",
    "46": "ام تسالهم اجرا فهم",
    "47": "عندهم الغيب فهم يكتبون",
    "48": "ولا تكن كصاحب الحوت",
    "49": "لنبذ بالعراء وهو مذموم",
    "50": "ربه فجعله من الصالحين",
    "51": "كفروا ليزلقونك بابصارهم لما",
    "52": "هو الا ذكر للعالمين"
  },
